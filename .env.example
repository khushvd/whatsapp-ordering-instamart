# Ordering Bot — Environment Configuration
# Copy to .env and fill in the required values.

# ===== OPTIONAL (normal users: skip this, set it in the Setup UI instead) =====
# The UI at http://localhost:3000 will prompt you for a Gemini API key on first
# run and store it locally in SQLite. Only set this here if you prefer managing
# secrets via .env (devs). Get a free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=                       # Google Gemini API key (voice → text + list parsing)

# ===== ALLOWLIST =====
# Leave these empty to configure via the UI (recommended).
# UI selections are merged with env values and persist in SQLite.
ALLOWED_GROUPS=                       # Comma-separated WhatsApp group IDs (e.g. 1234567890@g.us)
ALLOWED_GROUP_SENDERS=                # Comma-separated phone numbers / @c.us IDs

# ===== TRANSPORT (Baileys) =====
# Baileys runs in-process — no external service needed. The folder below stores
# the WhatsApp session (creds + pre-keys) as JSON files. Keep it off source
# control; delete it to force a fresh QR scan.
BAILEYS_AUTH_DIR=./data/baileys-auth
BAILEYS_LOG_LEVEL=warn                # pino level: trace|debug|info|warn|error|fatal
SESSION_NAME=default                  # Display label used in the dashboard

# ===== SWIGGY MCP =====
# Swiggy Instamart is reached over MCP. OAuth tokens are stored in SQLite via the
# !login flow; nothing sensitive lives here. Access tokens expire in 5 days (no
# refresh token from Swiggy), so expect to re-run !login weekly.
SWIGGY_MCP_URL=https://mcp.swiggy.com/im

# ===== STORAGE =====
ORDER_DB_PATH=./data/orders.sqlite

# ===== SERVER =====
PORT=3000
